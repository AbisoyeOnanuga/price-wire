PORT=8787
NODE_ENV=development

# --- Tier 0: leave all empty — sample comps + heuristics still work ---

# Tier 2: Tiger Data / Postgres (pgvector). npm run db:schema && npm run seed
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# If schema/seed fail with SELF_SIGNED_CERT_IN_CHAIN, set:
# DATABASE_SSL_INSECURE=true

# Tier 3: SerpApi — live marketplace snippets (eBay engine in serp-comps.ts)
SERPAPI_KEY=

# Tier 4: Prior Labs TabPFN platform
TABPFN_API_KEY=

# --- Tier 1: title → specs (Gemma). Pick Ollama and/or Google; heuristics always last. ---
#
# Recommended local dev (Ollama-first, no Google key):
#   ollama pull gemma2:2b
#   Leave GOOGLE_GENERATIVE_AI_API_KEY empty; run `ollama serve` if needed.
#
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma2:2b
# Prefer local Ollama before Google when both are set (also on when OLLAMA_ENABLED=true):
# OLLAMA_FIRST=true

# Tier 1b: Gemma/Gemini via Google AI (tried after Ollama when OLLAMA_FIRST=true, or first when not)
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GEMMA_MODEL=gemma-3-4b-it

# Tier 5: Sentry agent tracing (optional)
SENTRY_DSN=

# Production hardening (optional)
# ALLOWED_ORIGINS=https://your-app.onrender.com
# QUOTE_API_KEY=
# QUOTE_RATE_LIMIT=30
# Public demo: ~8/min per IP + ~25–40 quotes/day globally (2 SerpApi calls per live lookup)
# QUOTE_RATE_LIMIT=8
# QUOTE_DAILY_CAP=30
# Legacy (ignored): Serp runs whenever SERPAPI_KEY is set. Remove SERP_MIN_LOCAL_COMPS=4 from Render if set.
# SERP_MIN_LOCAL_COMPS=
#
# Render / production: Ollama is local-only unless you host Ollama elsewhere and set OLLAMA_BASE_URL.
# Default on Render: Google key OR heuristics. To use a remote Ollama: OLLAMA_ENABLED=true + OLLAMA_BASE_URL.
# OLLAMA_ENABLED=false
