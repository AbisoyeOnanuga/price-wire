PORT=8787
NODE_ENV=development

# --- Tier 0: leave all empty — sample comps + heuristics still work ---

# Tier 2: Tiger Data / Postgres (pgvector). npm run db:schema && npm run seed
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# If schema/seed fail with SELF_SIGNED_CERT_IN_CHAIN, set:
# DATABASE_SSL_INSECURE=true

# Tier 3: SerpApi — live marketplace snippets (eBay engine in serp-comps.ts)
SERPAPI_KEY=

# Tier 4: Prior Labs TabPFN platform
TABPFN_API_KEY=

# Tier 1b: Gemma/Gemini via Google AI
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GEMMA_MODEL=gemma-3-4b-it

# Tier 1a: local Gemma via Ollama (ollama pull gemma2:2b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma2:2b

# Tier 5: Sentry agent tracing (optional)
SENTRY_DSN=

# Production hardening (optional)
# ALLOWED_ORIGINS=https://your-app.onrender.com
# QUOTE_API_KEY=
# QUOTE_RATE_LIMIT=30
# SERP_MIN_LOCAL_COMPS=4
# OLLAMA_ENABLED=false
