PORT=8787
NODE_ENV=development

# --- Tier 0: leave all empty — sample comps + heuristics still work ---

# Tier 2: Tiger Data / Postgres (pgvector). Run sql/schema.sql then npm run seed
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Tier 3: SerpApi — live marketplace snippets (eBay engine in serp-comps.ts)
SERPAPI_KEY=

# Tier 4: Prior Labs TabPFN platform
TABPFN_API_KEY=

# Tier 1b: Gemma via Google AI
GOOGLE_GENERATIVE_AI_API_KEY=

# Tier 1a: local Gemma via Ollama (ollama pull gemma2:2b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma2:2b

# Tier 5: Sentry agent tracing (optional)
SENTRY_DSN=
