PORT=8787
NODE_ENV=development

# Tiger Data / Postgres (pgvector)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# SerpApi — live marketplace snippets
SERPAPI_KEY=

# Prior Labs TabPFN platform
TABPFN_API_KEY=

# Gemma via Google AI (open-weight Gemma models)
GOOGLE_GENERATIVE_AI_API_KEY=

# Or local Gemma through Ollama (preferred for open/local demos)
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma2:2b

# Sentry agent tracing (optional)
SENTRY_DSN=
